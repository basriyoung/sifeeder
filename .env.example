# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit berkas .env ke git.
#
# Set izin berkas agar hanya bisa dibaca pemiliknya:
#   chmod 600 .env

# ----------------------------------------------------------------------
# Web service Neo Feeder
# ----------------------------------------------------------------------
# Alamat ws/live2.php. Port bawaan Neo Feeder biasanya 3003 (versi lama: 8082).
FEEDER_URL=http://127.0.0.1:3003/ws/live2.php

# Username = kode perguruan tinggi, password = password Feeder PT.
FEEDER_USERNAME=
FEEDER_PASSWORD=

# Batas waktu (detik). Operasi tulis diberi waktu lebih panjang.
FEEDER_TIMEOUT=60
FEEDER_TIMEOUT_WRITE=120

# Percobaan ulang HANYA berlaku untuk operasi baca (act Get*).
# Operasi tulis tidak pernah diulang otomatis.
FEEDER_MAX_RETRIES=3
FEEDER_RETRY_BASE_DELAY=1.0

# Jeda antar request dalam detik, untuk menjaga beban server Feeder.
FEEDER_THROTTLE_SECONDS=0.05

# Masa berlaku token yang diasumsikan (detik). Token kedaluwarsa juga
# dideteksi langsung dari jawaban server, jadi nilai ini hanya ancang-ancang.
FEEDER_TOKEN_TTL_SECONDS=3000

# Biarkan true. Set false hanya bila Feeder memakai sertifikat internal
# dan Anda memahami risikonya.
FEEDER_VERIFY_TLS=true

# Izinkan HTTP polos ke host NON-lokal. Biarkan false kecuali terpaksa:
# bila true, username, password, dan token terkirim tanpa enkripsi.
FEEDER_ALLOW_INSECURE_HTTP=false

# ----------------------------------------------------------------------
# Login aplikasi (bukan login Neo Feeder)
# ----------------------------------------------------------------------
APP_USERNAME=admin

# Hasilkan dua nilai di bawah dengan:  python scripts/hash_password.py
APP_PASSWORD_HASH=
SESSION_SECRET=

SESSION_MAX_AGE_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Set true bila aplikasi diakses lewat HTTPS (wajib untuk akses non-lokal).
COOKIE_SECURE=false

# ----------------------------------------------------------------------
# Sinkronisasi dan penyimpanan
# ----------------------------------------------------------------------
SYNC_BATCH_SIZE=100
DATA_DIR=./data
DB_PATH=./data/sync.db
LOG_PATH=./data/logs/sync.log

# Samarkan NIM, nama, dan NIK di dalam berkas log.
MASK_PERSONAL_DATA=true

# ----------------------------------------------------------------------
# Server web
# ----------------------------------------------------------------------
HOST=127.0.0.1
PORT=8700
